{
  "capability_id": "check_savings_balance",
  "version": "1.0.0",
  "status": "draft",
  "description": "Look up a member by Customer ID and read their current savings balance.",
  "target_app": {
    "app_id": "corebank",
    "surface_type": "web"
  },
  "risk_class": "safe",
  "provenance": {
    "created_from_run": "fixture_handcrafted_check_savings_balance",
    "created_at": "2026-09-13T00:00:00Z",
    "last_validated_at": null,
    "confidence": 0.0
  },
  "input_params": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "description": "Customer ID to look up",
      "example": "10001"
    }
  ],
  "steps": [
    {
      "step_id": "s1",
      "action": "navigate",
      "target": {
        "kind": "url",
        "value": "/search"
      },
      "risk_class": "safe",
      "description": "Open the Member Search screen"
    },
    {
      "step_id": "s2",
      "action": "type",
      "target": {
        "kb_element_id": "corebank.search.member_id_field",
        "locator": {
          "primary": {
            "strategy": "role+name",
            "value": "textbox:Customer ID"
          },
          "fallbacks": [
            {
              "strategy": "css",
              "value": "input[name=customer_id]"
            }
          ]
        }
      },
      "value_from_param": "member_id",
      "risk_class": "safe",
      "description": "Enter the Customer ID"
    },
    {
      "step_id": "s3",
      "action": "click",
      "target": {
        "kb_element_id": "corebank.search.submit_button",
        "locator": {
          "primary": {
            "strategy": "role+name",
            "value": "button:Search"
          },
          "fallbacks": [
            {
              "strategy": "css",
              "value": "form[action='/search'] input[type=submit]"
            }
          ]
        }
      },
      "risk_class": "safe",
      "description": "Run the member lookup"
    },
    {
      "step_id": "s4",
      "action": "click",
      "target": {
        "kb_element_id": "corebank.member.account_tab",
        "locator": {
          "primary": {
            "strategy": "role+name",
            "value": "link:Account"
          },
          "fallbacks": [
            {
              "strategy": "css",
              "value": "a[href*='tab=account']"
            }
          ]
        }
      },
      "risk_class": "safe",
      "description": "Switch to the Account tab"
    },
    {
      "step_id": "s5",
      "action": "extract",
      "target": {
        "kb_element_id": "corebank.account.savings_balance_cell",
        "locator": {
          "primary": {
            "strategy": "css",
            "value": "table[border='1'] tr:nth-child(2) td:nth-child(3)"
          },
          "fallbacks": [
            {
              "strategy": "css",
              "value": "tr:nth-child(2) td:nth-child(3)"
            }
          ]
        }
      },
      "risk_class": "safe",
      "description": "Read the savings Available Balance from inside the ledger iframe"
    }
  ],
  "checkpoint": {
    "type": "element_present_with_pattern",
    "target": {
      "kb_element_id": "corebank.account.savings_balance_cell",
      "locator": {
        "primary": {
          "strategy": "css",
          "value": "table[border='1'] tr:nth-child(2) td:nth-child(3)"
        },
        "fallbacks": [
          {
            "strategy": "css",
            "value": "tr:nth-child(2) td:nth-child(3)"
          }
        ]
      }
    },
    "pattern": "^\\$?[0-9,]+\\.[0-9]{2}$"
  },
  "outputs": [
    {
      "name": "current_balance",
      "type": "currency",
      "source_step": "s5"
    }
  ],
  "known_outcomes": [
    {
      "code": "member_not_found",
      "type": "business_outcome",
      "detector": {
        "text_contains": "No member found with that ID"
      },
      "message": "No member found with that ID"
    },
    {
      "code": "permission_denied",
      "type": "business_outcome",
      "detector": {
        "text_contains": "is restricted"
      },
      "message": "This member's account is restricted and cannot be serviced"
    },
    {
      "code": "session_expired",
      "type": "recoverable",
      "detector": {
        "url_contains": "/login"
      },
      "message": "The operator session expired mid-flow",
      "recovery": "reauthenticate_and_retry"
    }
  ],
  "review": {
    "status": "not_reviewed",
    "optimization_notes": null,
    "reviewed_at": null
  },
  "requires": [
    "operator_login"
  ]
}
