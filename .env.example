# MongoDB connection string.
# Leave unset/blank to run against the built-in in-memory fallback store.
# Local:  mongodb://127.0.0.1:27017/corebank
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/corebank
MONGODB_URI=mongodb://127.0.0.1:27017/corebank

# Any random string; signs the Flask session cookie.
FLASK_SECRET_KEY=change-me-to-something-random

# Optional: overrides the bind port (default 5050).
PORT=5050
