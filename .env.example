# Engine configuration. Copy to `.env` and fill in — `.env` is gitignored, this file is not.
#
#     cp .env.example .env
#
# Everything here is also settable as a plain environment variable; the .env file is just a
# convenience so you are not re-exporting on every shell. Real values belong ONLY in .env.

# --- Model access -------------------------------------------------------------------
# Required for `discover` (the LLM-driven loop). NOT required for `replay`, which never
# calls a model — that separation is the point of the system, so replay stays runnable
# with no key at all.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-pro.
# GEMINI_MODEL=gemini-2.5-pro

# --- Target application -------------------------------------------------------------
# The deployment to drive. `replay` requires this (or --target); artifacts store paths,
# not hosts, so the same capability replays against any institution running the app.
ENGINE_TARGET=http://127.0.0.1:5050

# Set to 1 to run the browser without a visible window. Leave unset for normal use: the
# visible window is what a human takes control of during an escalation handoff.
# ENGINE_HEADLESS=1

# --- Operator credentials -----------------------------------------------------------
# Passed to a login capability as ordinary run parameters. They are never written into an
# artifact, a log or a report — a parameter marked `secret` is typed at the keyboard and
# rendered as «redacted» everywhere else.
COREBANK_USERNAME=operator1
COREBANK_PASSWORD=pass1234
